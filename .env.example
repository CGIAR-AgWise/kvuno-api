
FLASK_ENV=development
FLASK_APP=development
FLASK_DEBUG=true
DEBUG_DB=false
LOG_LEVEL=INFO

# Database — set DB_URL for full control, or set individual parts:
# DB_URL="postgresql://postgres:postgres@127.0.0.1:5432/agwise_api"
DB_DRIVER=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=agwise_api

# Directory where RDS/Parquet files are stored
# HOUSEKEEPING_DATA_DIR=static/data

# Set to false to disable housekeeping at app startup
# HOUSEKEEPING_ENABLED=true

# Processing tuning
# HOUSEKEEPING_BATCH_SIZE=2000
# HOUSEKEEPING_CHUNK_SIZE=5000
# HOUSEKEEPING_CHECKPOINT_INTERVAL=50
# HOUSEKEEPING_MAX_WORKERS=1

# Comma-separated allowed CORS origins (no spaces)
# CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# Max upload file size (MB) — used by the upload UI
# MAX_FILE_SIZE_MB=20

# Remote RDS file URLs to download before processing (semicolon-delimited)
REMOTE_RDS_URLS="https://example.com/data/sample.RDS"

# Optional: Bearer token for remote authentication
# REMOTE_RDS_TOKEN="your-token-here"

# Optional: Cookies for remote auth (comma-separated key=value pairs)
# REMOTE_RDS_COOKIES="key1=value1,key2=value2"

# Optional: Custom HTTP headers (comma-separated key:value pairs)
# REMOTE_RDS_HEADERS="X-Custom:value1"

# Celery / Redis
# Format: redis://[[user]:[password]]@host:port/db
# Local (no auth):   redis://localhost:6379/0
# Production (auth): redis://:mysecretpassword@redis:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# CELERY_TASK_MAX_RETRIES=10
# CELERY_TASK_RETRY_DELAY=60

# Optional: JSON mapping of RDS column names to DB record attributes
# RDS_COLUMN_MAP='{"Variety":"variety"}'

# Cleanup: remove processed files older than this duration (cold start)
# Supports m (minutes), h (hours), d (days), w (weeks). Default: 1d
# CLEANUP_AGE=1d

# ── Auth / Tokens ──────────────────────────────────────────────
#
# Tokens are opaque `{id}|{secret}` values generated per token and stored as a
# SHA-256 hash. There is no signing key and no JWT_SECRET to configure.
#
# Token lifetime (days). 0 = never expire.
# TOKEN_TTL_DAYS=0
#
# Rate-limit storage backend. Use redis:// for distributed rate counting.
# RATE_LIMIT_STORAGE=memory://

# ── Rate limits (flask-limiter syntax) ─────────────────────────
# RATE_LIMIT_REGISTER=10 per hour
# RATE_LIMIT_LOGIN=20 per hour
# RATE_LIMIT_UPLOAD=10 per hour
# RATE_LIMIT_DATA=120 per minute

# ── Frontend (React SPA) ───────────────────────────────────────
#
# The UI is a separate Vite + React app in frontend/, served by its own nginx
# container which reverse-proxies /api and /ui to this API. This service no
# longer renders HTML.
#
# Where GET / redirects — MUST be the SPA's origin, not this service.
# Left unset, GET / returns a small JSON pointer instead of redirecting.
# It must not be '/': that points the browser back at this service, which
# redirects again, giving an infinite redirect loop in the browser.
# In the compose setup the SPA is a separate `web` container, so set this to
# however you reach it (host and WEB_PORT), e.g. http://127.0.0.1:8080
# SPA_ROOT_URL=http://127.0.0.1:8080

# Client-side route an unauthenticated browser is sent to. Default `/login`.
# Change this only if the SPA is mounted under a prefix (e.g. /app/login).
# SPA_LOGIN_PATH=/login

# Host port for the `web` compose service (nginx). Not read by Flask —
# docker-compose.yml interpolates it. Default: 8080
# WEB_PORT=8080

# CORS origins. Unused in production (nginx proxies, so the browser sees one
# origin); set this for a separately hosted SPA or for `pnpm dev` on :5173.
# CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5173,http://127.0.0.1:5173

# ── Startup preflight ─────────────────────────────────────────
#
# The API and worker verify their dependencies before doing any work, and exit
# non-zero if a *required* one is unreachable, so the container is restarted
# instead of booting into a state where every request fails.
#
# Redis is required for the worker always, and for the API only when
# HOUSEKEEPING_ENABLED=true (with housekeeping off, progress is stored in
# PostgreSQL and nothing is enqueued).
#
# Skip the check entirely (escape hatch): PREFLIGHT_ENABLED=false
# PREFLIGHT_ENABLED=true
#
# Give up after this many attempts, waiting PREFLIGHT_DELAY_SECONDS between.
# 30 attempts x 2s = 60s of tolerance for a slow-starting database.
# PREFLIGHT_RETRIES=30
# PREFLIGHT_DELAY_SECONDS=2
#
# Per-probe connect timeout, in seconds.
# PREFLIGHT_TIMEOUT_SECONDS=3
