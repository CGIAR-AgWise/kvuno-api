# Generated from app/config.py by scripts/gen_config_docs.py — do not edit.
# Copy to .env and fill in. Commented lines show the default (or an example);
# uncomment one only to change it. An empty value also means "use the default".
#
# IITA Internal Use

# ── Application ───────────────────────────────────────────────────────────
# production/prod → JSON log lines (for Loki etc.); anything else → readable console
# logs.
ENVIRONMENT=development
# Version reported by /health and the API docs; set by the image build.
# APP_VERSION=
# Fallback for APP_VERSION when built in GitHub Actions.
# GITHUB_REF_NAME=
# The web app's URL: target of `GET /` for API clients, linked from the landing page,
# and the base of links in emails (only when an absolute http(s) URL).
# SPA_ROOT_URL=https://kvuno-ui.example.org
# Where `require_auth` sends an unauthenticated browser (a client-side SPA route).
# SPA_LOGIN_PATH=/login

# ── Logging ───────────────────────────────────────────────────────────────
# The one log level for every process (API, worker, gunicorn, migrations). One of:
# DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
# Where logs go; keep stdout in containers (what docker logs / Dokploy collect). One of:
# stdout, stderr, file.
# LOG_DESTINATION=stdout
# Rotation for LOG_DESTINATION=file. One of: size, daily.
# LOG_ROTATION=size
# Log file for LOG_DESTINATION=file.
# LOG_FILE_PATH=logs/kvuno.log
# Rotate the log file past this size (LOG_ROTATION=size).
# LOG_MAX_BYTES=10485760
# Rotated log files to keep.
# LOG_BACKUP_COUNT=5
# Log every SQL statement, whatever LOG_LEVEL says (very verbose).
# DEBUG_DB=false

# ── Database ──────────────────────────────────────────────────────────────
# Full SQLAlchemy URL; wins over the DB_* parts below.
# DB_URL=
# postgresql, or sqlite for UI/auth work without Postgres (ingestion and spatial queries
# need Postgres).
DB_DRIVER=postgresql
# Database host (from inside a container: not localhost).
DB_HOST=127.0.0.1
# Database port.
DB_PORT=5432
# Database user. Required unless DB_URL is set or DB_DRIVER=sqlite.
DB_USER=postgres
# Database password. Required unless DB_URL is set or DB_DRIVER=sqlite.
DB_PASSWORD=postgres
# Database name. Required unless DB_URL is set; with DB_DRIVER=sqlite the file name
# (default kvuno.db).
DB_NAME=agwise_api
# Container entrypoint applies migrations before start (compose sets false).
# RUN_MIGRATIONS=true

# ── Web server (development) and HTTP ─────────────────────────────────────
# Debug mode for `python run.py`; it then starts even when the preflight fails.
FLASK_DEBUG=true
# Bind address for `python run.py`.
# SERVER_HOST=0.0.0.0
# Port for `python run.py`.
# SERVER_PORT=80
# Server listed in the OpenAPI document.
# SERVER_URL_PROD=https://kvuno.agwise.org
# Second server listed in the OpenAPI document.
# SERVER_URL_PROD_2=https://kvuno.akilimo.org
# Comma-separated origins allowed cross-origin (only `pnpm dev`; production is same-
# origin).
# CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5173,http://127.0.0.1:5173
# Trusted proxies in front of the app, for real client IPs. 0 when nothing proxies it,
# or X-Forwarded-For can be forged to evade rate limits.
# PROXY_FIX_HOPS=1
# Sort keys in JSON responses.
# SORT_JSON=false
# Map points returned by the bulk coordinates endpoint (a random sample beyond this).
# COORDINATES_BULK_MAX_ROWS=5000

# ── Gunicorn (production web server) ──────────────────────────────────────
# Gunicorn bind address.
# BIND_IP=0.0.0.0
# Gunicorn port.
# BIND_PORT=80
# Gunicorn listen backlog.
# BACKLOG=2048
# Gunicorn worker class (gthread: the SSE stream needs threads).
# WORKER_CLASS=gthread
# Gunicorn worker processes.
# WORKERS=2
# Threads per gunicorn worker.
# THREADS=4
# Max simultaneous clients per worker.
# WORKER_CONNECTIONS=1000
# Gunicorn heartbeat directory.
# WORKER_TMP_DIR=/dev/shm
# Load the app before forking (unsafe with SQLAlchemy; leave off).
# PRELOAD_APP=false
# Seconds before a silent worker is killed (raised from 30 for inline API upload
# conversion).
# TIMEOUT=120
# Seconds to finish requests on restart.
# GRACEFUL_TIMEOUT=30
# Keep-alive seconds.
# KEEPALIVE=5
# Recycle a worker after this many requests.
# MAX_REQUESTS=1000
# Random spread so workers do not recycle together.
# MAX_REQUESTS_JITTER=100
# Access log target ('-' = stdout).
# ACCESSLOG=-
# Error log target ('-' = stderr).
# ERRORLOG=-

# ── Accounts and authentication ───────────────────────────────────────────
# Comma-separated owner addresses (case-insensitive): administrators who cannot be
# demoted, approved at once on registration, and sent new-registration notices. Unset:
# nobody can approve new accounts unless one already holds the admin role.
# ADMIN_EMAILS=admin@example.org
# Days a sign-in token lasts; 0 = no expiry.
# TOKEN_TTL_DAYS=0

# ── Email (optional) ──────────────────────────────────────────────────────
# SMTP server; unset → no email is sent, and the log says so.
# SMTP_HOST=smtp.example.org
# SMTP port.
# SMTP_PORT=587
# SMTP login, skipped when empty (Mailgun: postmaster@<domain>).
# SMTP_USERNAME=
# SMTP password.
# SMTP_PASSWORD=
# starttls (587), ssl (465) or none (local relay). One of: starttls, ssl, none.
# SMTP_SECURITY=starttls
# SMTP connect/send timeout.
# SMTP_TIMEOUT_SECONDS=15
# Sender address; unset = no email is sent.
# MAIL_FROM=noreply@example.org
# Name used in the From: header and message text.
# MAIL_APP_NAME=KVuno

# ── Uploads and data files ────────────────────────────────────────────────
# Largest upload accepted, in MB; enforced at tus creation, before any bytes arrive.
# MAX_FILE_SIZE_MB=20
# Remove uploads idle this long (30m, 12h, 1d, 2w).
# UPLOAD_ABANDON_AGE=7d
# An upload `inspecting` this long is re-claimed on the next status poll.
# UPLOAD_INSPECT_STALE_SECONDS=180
# Remove files of jobs completed this long ago (30m, 12h, 1d, 2w).
# CLEANUP_AGE=1d

# ── Ingestion (housekeeping) ──────────────────────────────────────────────
# Hand /api/v1/data/upload and Jobs retries of plain data-folder files to the Celery
# worker (needs Redis). SPA uploads and the startup scan run in the API process either
# way.
# HOUSEKEEPING_ENABLED=false
# Import new files in HOUSEKEEPING_DATA_DIR when the API starts: queued for the Celery
# worker when HOUSEKEEPING_ENABLED, otherwise run by one API process.
# STARTUP_SCAN=true
# After a startup scan, API processes booting within this many seconds (sibling gunicorn
# workers, recycled ones) skip theirs. Minimum 60.
# STARTUP_SCAN_COOLDOWN_SECONDS=300
# Worker image only: run housekeeping.py instead of Celery — oneshot (scan once and
# exit), watch (keep importing new files) or dryrun (report only). Unset: the normal
# Celery worker.
# HOUSEKEEPING_MODE=
# Directory holding data files; uploads go to its `uploads/` subdirectory.
# HOUSEKEEPING_DATA_DIR=static/data
# Rows per insert batch.
# HOUSEKEEPING_BATCH_SIZE=2000
# Rows read per chunk (sizes insert batches, not memory).
# HOUSEKEEPING_CHUNK_SIZE=5000
# Batches between offset checkpoints.
# HOUSEKEEPING_CHECKPOINT_INTERVAL=50
# Parallel files in a directory scan.
# HOUSEKEEPING_MAX_WORKERS=1
# Take over a per-file ingest lock silent this long.
# INGEST_LOCK_STALE_SECONDS=600
# Hold data-folder files whose columns the default mapping does not cover (no lat/lon)
# for mapping on the Upload page, instead of importing them with a mapping that finds no
# coordinates.
# INGEST_HOLD_UNMAPPED=true
# Recognise files already imported (by SHA-256): warn at upload and skip at import. Off:
# a re-sent file is imported again; rows already stored are still not duplicated (unique
# constraint).
# INGEST_DUPLICATE_CHECK=true
# Record rows that clash with stored ones in import_conflicts (the Quality page). Off:
# faster imports; clashing rows are still skipped, just not recorded.
# INGEST_CONFLICT_LOGGING=true
# JSON object overriding the default source→DB column map.
# RDS_COLUMN_MAP={"Variety": "variety"}

# ── Celery / Redis ────────────────────────────────────────────────────────
# Redis URL for the Celery broker (also SSE and the cache).
# CELERY_BROKER_URL=redis://localhost:6379/0
# Celery result backend URL.
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Celery queue name.
# CELERY_TASK_DEFAULT_QUEUE=kvuno
# Retries for a task failing on a transient error.
# CELERY_TASK_MAX_RETRIES=10
# Seconds between task retries.
# CELERY_TASK_RETRY_DELAY=60
# Seconds before Redis redelivers an unacked task, even a running one: must exceed the
# longest single-file ingest.
# CELERY_VISIBILITY_TIMEOUT=21600
# Worker processes (worker image and `python dev_worker.py`). 2: an upload is read while
# another file imports. Each RDS being read needs ~150x its size in memory.
# CELERY_CONCURRENCY=2
# MB; recycle a worker child past this (set above one file's peak).
# WORKER_MAX_MEMORY_PER_CHILD=2048
# Recycle a worker child after this many tasks.
# WORKER_MAX_TASKS_PER_CHILD=50

# ── Job progress ──────────────────────────────────────────────────────────
# A processing job silent this long is shown as stale.
# JOB_STALE_AFTER_SECONDS=1800
# Redis expiry of a job's progress entry.
# JOB_PROGRESS_TTL_SECONDS=604800
# Minimum seconds between published progress updates.
# JOB_PROGRESS_MIN_INTERVAL=1.0
# Minimum seconds between durable progress writes.
# JOB_DB_CHECKPOINT_SECONDS=5.0

# ── Remote RDS downloads ──────────────────────────────────────────────────
# Semicolon-separated HTTPS URLs fetched before a scan.
# REMOTE_RDS_URLS=https://example.com/data/sample.RDS
# Bearer token for the downloads.
# REMOTE_RDS_TOKEN=
# Cookies, comma-separated `name=value` pairs.
# REMOTE_RDS_COOKIES=
# Extra headers, comma-separated `Name: value` pairs.
# REMOTE_RDS_HEADERS=
# Comma-separated hosts downloads may come from (exact or subdomain).
# REMOTE_RDS_ALLOWED_DOMAINS=
# Allow plain-HTTP download URLs.
# REMOTE_RDS_ALLOW_HTTP=false
# Largest download accepted, in bytes (checked while streaming).
# REMOTE_RDS_MAX_BYTES=1073741824

# ── Rate limiting ─────────────────────────────────────────────────────────
# Registration limit (flask-limiter syntax).
# RATE_LIMIT_REGISTER=10 per hour
# Sign-in limit.
# RATE_LIMIT_LOGIN=20 per hour
# API upload limit.
# RATE_LIMIT_UPLOAD=10 per hour
# Planting-data endpoints limit.
# RATE_LIMIT_DATA=120 per minute
# Bulk coordinates endpoint limit.
# RATE_LIMIT_COORDINATES_BULK=20 per minute
# Requests per hour (a bare count) for any route without its own limit. If real users
# see 429s, raise this rather than the per-endpoint limits.
# RATE_LIMIT_DEFAULT_HOURLY=600
# Requests per day (a bare count), as above.
# RATE_LIMIT_DEFAULT_DAILY=5000
# Counter storage; use Redis with several gunicorn workers.
# RATE_LIMIT_STORAGE=memory://

# ── Startup preflight ─────────────────────────────────────────────────────
# Check the database (and Redis when required) before starting; false skips it.
# PREFLIGHT_ENABLED=true
# Timeout per check.
# PREFLIGHT_TIMEOUT_SECONDS=3
# Attempts before giving up.
# PREFLIGHT_RETRIES=30
# Seconds between attempts (30 x 2 s = 60 s tolerance).
# PREFLIGHT_DELAY_SECONDS=2
# Role when the preflight is run without an argument. One of: api, worker.
# PREFLIGHT_ROLE=api

# ── Developer tooling ─────────────────────────────────────────────────────
# model-generator.py output file.
# OUTFILE_PATH=app/models/kvuno.py
# model-generator.py tables to skip.
# EXCLUDED_TABLES=spatial_ref_sys,alembic_version
