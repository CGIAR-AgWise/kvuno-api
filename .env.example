
FLASK_ENV=development
FLASK_APP=development
FLASK_DEBUG=true
DEBUG_DB=false
LOG_LEVEL=INFO

# Database — set DB_URL for full control, or set individual parts:
# DB_URL="postgresql://postgres:postgres@127.0.0.1:5432/agwise_api"
DB_DRIVER=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=agwise_api

# Directory where RDS/Parquet files are stored
# HOUSEKEEPING_DATA_DIR=static/data

# Set to false to disable housekeeping at app startup
# HOUSEKEEPING_ENABLED=true

# Processing tuning
# HOUSEKEEPING_BATCH_SIZE=2000
# HOUSEKEEPING_CHUNK_SIZE=5000
# HOUSEKEEPING_CHECKPOINT_INTERVAL=50
# HOUSEKEEPING_MAX_WORKERS=1

# Comma-separated allowed CORS origins (no spaces)
# CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# Max upload file size (MB). Enforced by the API when a tus upload is created,
# before any bytes are accepted (413); the SPA reads it from /ui/columns.
# MAX_FILE_SIZE_MB=20

# Unsubmitted uploads (HOUSEKEEPING_DATA_DIR/uploads/<id>/) idle longer than
# this are deleted when an API worker boots. Same format as CLEANUP_AGE.
# UPLOAD_ABANDON_AGE=7d

# Seconds an upload may sit in `inspecting` without a heartbeat before the next
# status poll re-claims it (the API worker running inspection was recycled).
# UPLOAD_INSPECT_STALE_SECONDS=180

# Remote RDS file URLs to download before processing (semicolon-delimited)
REMOTE_RDS_URLS="https://example.com/data/sample.RDS"

# Optional: Bearer token for remote authentication
# REMOTE_RDS_TOKEN="your-token-here"

# Optional: Cookies for remote auth (comma-separated key=value pairs)
# REMOTE_RDS_COOKIES="key1=value1,key2=value2"

# Optional: Custom HTTP headers (comma-separated key:value pairs)
# REMOTE_RDS_HEADERS="X-Custom:value1"

# ── SSRF guards for remote downloads ──────────────────────────
#
# These protect `download_remote_files()` in services/housekeeper.py, which
# fetches whatever REMOTE_RDS_URLS points at. Both default to the safe setting,
# so you should not need to set them — they are here because turning either
# off weakens the protection, and that should be a deliberate, visible choice.
#
# HTTPS is required by default. Setting this to true allows plain HTTP, which
# exposes the download to interception and tampering. Only for a trusted
# internal host.
# REMOTE_RDS_ALLOW_HTTP=false
#
# Comma-separated allow-list of hostnames. When set, only these domains may be
# downloaded; anything else is refused. Leave unset to rely on the IP-level
# checks alone (private, loopback, link-local and cloud metadata ranges are
# always rejected regardless of this setting).
# REMOTE_RDS_ALLOWED_DOMAINS=files.example.org,cdn.example.org
#
# Matching is exact or a true subdomain: `example.org` allows `example.org` and
# `cdn.example.org`, but NOT `example.org.evil.com` or `notexample.org`.
# Redirects are followed manually (max 5 hops) and every hop is re-checked;
# the bearer token (Authorization) is dropped when a redirect leaves the
# original host. REMOTE_RDS_COOKIES are NOT host-scoped and are still sent, so
# do not combine cookies with a source that redirects off-host. After
# connecting, the socket's peer IP is re-checked against the private ranges
# (DNS-rebinding guard, best effort — skipped when an HTTP(S) proxy is in use).
#
# Maximum bytes for one remote download, enforced while streaming; a file that
# exceeds it is deleted and the download fails. Default 1 GiB.
# REMOTE_RDS_MAX_BYTES=1073741824

# Celery / Redis
# Format: redis://[[user]:[password]]@host:port/db
# Local (no auth):   redis://localhost:6379/0
# Production (auth): redis://:mysecretpassword@redis:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# CELERY_TASK_MAX_RETRIES=10
# CELERY_TASK_RETRY_DELAY=60
#
# Seconds Redis waits before redelivering an unacked task. Tasks are acked late,
# so a task still running past this gets a second, concurrent copy. MUST exceed
# the longest single-file ingest. Default 21600 (6 h).
# CELERY_VISIBILITY_TIMEOUT=21600
#
# Per-file ingest lock (`<file>.ingest.lock` next to the data file). The holder
# refreshes it every chunk; a lock untouched this long is taken over as dead.
# Keep it well above the slowest chunk (and a large RDS deserialise). Default 600.
# INGEST_LOCK_STALE_SECONDS=600
#
# NOTE: the compose `worker` service has no env_file — it only receives the
# variables listed in its `environment:` block (both of these are listed there).

# Optional: JSON mapping of RDS column names to DB record attributes
# RDS_COLUMN_MAP='{"Variety":"variety"}'

# Cleanup: remove files of completed jobs older than this duration (worker boot)
# Supports m (minutes), h (hours), d (days), w (weeks). Default: 1d
# CLEANUP_AGE=1d

# ── Auth / Tokens ──────────────────────────────────────────────
#
# Tokens are opaque `{id}|{secret}` values generated per token and stored as a
# SHA-256 hash. There is no signing key and no JWT_SECRET to configure.
#
# Token lifetime (days). 0 = never expire.
# TOKEN_TTL_DAYS=0
#
# Self-registration allow-list: comma-separated email domains, case-insensitive.
# Matched on the exact domain after '@' (sub.cgiar.org is NOT covered by
# cgiar.org; list it separately). EMPTY OR UNSET DISABLES REGISTRATION — the
# endpoint returns 403. Existing users and login are not affected.
# REGISTRATION_ALLOWED_DOMAINS=cgiar.org,iita.org
#
# Rate-limit storage backend. Use redis:// for distributed rate counting.
# RATE_LIMIT_STORAGE=memory://

# ── Rate limits (flask-limiter syntax) ─────────────────────────
# RATE_LIMIT_REGISTER=10 per hour
# RATE_LIMIT_LOGIN=20 per hour
# RATE_LIMIT_UPLOAD=10 per hour
# RATE_LIMIT_DATA=120 per minute

# ── Frontend (React SPA) ───────────────────────────────────────
#
# The UI is a separate Vite + React app in frontend/, served by its own nginx
# container which reverse-proxies /api and /ui to this API. This service no
# longer renders HTML.
#
# Where GET / redirects — MUST be the SPA's origin, not this service.
# Left unset, GET / returns a small JSON pointer instead of redirecting.
# It must not be '/': that points the browser back at this service, which
# redirects again, giving an infinite redirect loop in the browser.
# In the compose setup the SPA is a separate `web` container, published on
# host 127.0.0.1:5001, so set this to however you reach it, e.g.
# SPA_ROOT_URL=http://127.0.0.1:5001

# Client-side route an unauthenticated browser is sent to. Default `/login`.
# Change this only if the SPA is mounted under a prefix (e.g. /app/login).
# SPA_LOGIN_PATH=/login

# (There is no WEB_PORT: docker-compose.yml hardcodes the `web` mapping as
# "127.0.0.1:5001:80". Edit the compose file or an override to change it.)

# CORS origins. Unused in production (nginx proxies, so the browser sees one
# origin); set this for a separately hosted SPA or for `pnpm dev` on :5173.
# CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5173,http://127.0.0.1:5173

# ── Startup preflight ─────────────────────────────────────────
#
# The API and worker verify their dependencies before doing any work, and exit
# non-zero if a *required* one is unreachable, so the container is restarted
# instead of booting into a state where every request fails.
#
# Redis is required for the worker always, and for the API only when
# HOUSEKEEPING_ENABLED=true (with housekeeping off, progress is stored in
# PostgreSQL and nothing is enqueued).
#
# Skip the check entirely (escape hatch).
# Note: with FLASK_DEBUG=true, `python run.py` only warns on failure and starts
# anyway — containers still hard-fail, because the entrypoint check is separate.
# PREFLIGHT_ENABLED=false
# PREFLIGHT_ENABLED=true
#
# Give up after this many attempts, waiting PREFLIGHT_DELAY_SECONDS between.
# 30 attempts x 2s = 60s of tolerance for a slow-starting database.
# PREFLIGHT_RETRIES=30
# PREFLIGHT_DELAY_SECONDS=2
#
# Per-probe connect timeout, in seconds.
# PREFLIGHT_TIMEOUT_SECONDS=3

# ── Bulk coordinates (map) ─────────────────────────────────────
#
# The map's "All points" fetches every matching coordinate pair in ONE
# request. Paging /coordinates reaches the same data at one request per 500
# rows, so a 2M-row dataset needs thousands of requests and exhausts the rate
# limit long before the map finishes loading.
#
# Hard row cap on that single response. 5,000 is deliberate: the map shows a
# density impression, and a dense plot of tens of thousands of dots reads as a
# solid blob, so 5,000 conveys the shape for ~120 KB. The rows are a RANDOM
# sample of the filtered set, not the first N — data often arrives grouped by
# region, and the first N would be geographically clumped and misleading.
# Raise it if a specific view genuinely needs more.
# COORDINATES_BULK_MAX_ROWS=5000
#
# Rate limit for the bulk endpoint, deliberately looser than RATE_LIMIT_DATA
# because it is one request rather than a walk.
# RATE_LIMIT_COORDINATES_BULK=20 per minute

# ── Reverse proxy ──────────────────────────────────────────────
#
# Number of trusted proxies in front of this app. Default 1, which matches the
# nginx container that serves the React SPA: it forwards X-Forwarded-For, and
# without ProxyFix Flask ignores it, so get_remote_address() returns the
# nginx IP and EVERY user shares one rate-limit bucket.
#
# ⚠️ ProxyFix trusts the forwarded headers unconditionally. If this app is ever
# reachable WITHOUT a proxy in front of it, a client can set its own
# X-Forwarded-For and bypass every rate limit. Set 0 in that case — e.g. when
# running `python run.py` directly onto a public port.
#
# Use 2 if there is also a CDN or load balancer ahead of the nginx.
# PROXY_FIX_HOPS=1
