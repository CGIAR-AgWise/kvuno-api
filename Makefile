# kvuno — common commands. Run `make` or `make help` to list them.
#
# Recipes are single commands that behave the same under sh (Linux, macOS,
# Git Bash) and cmd (GNU make on Windows), so nothing here uses rm, test or
# other shell-only syntax. Override variables on the command line, e.g.
#   make migration MSG="add uploads index"
#   make housekeeping ARGS="--dry-run static/data"

POETRY ?= poetry
PNPM   ?= pnpm
WEB    := frontend
PY     := $(POETRY) run python

MSG  ?= describe the change
ARGS ?=

.DEFAULT_GOAL := help
.PHONY: help install install-api install-web lint lint-api lint-web test audit check \
        dev worker web build-web migrate migration housekeeping preflight \
        up down logs build clean

help: ## List the targets
	@$(PY) -c "import re; [print(f'  {m[1]:<14} {m[2]}') for m in re.finditer(r'^([a-z-]+):.*?## (.*)$$', open('Makefile', encoding='utf-8').read(), re.M)]"

# ── Setup ────────────────────────────────────────────────────────

install: install-api install-web ## Install API and SPA dependencies

install-api: ## poetry install (venv in .venv)
	$(POETRY) install

install-web: ## pnpm install in frontend/
	$(PNPM) -C $(WEB) install

# ── Quality gates (what CI runs) ─────────────────────────────────

lint: lint-api lint-web ## Lint API (ruff) and type-check the SPA (tsc)

lint-api: ## ruff check .
	$(POETRY) run ruff check .

lint-web: ## tsc -b in frontend/
	$(PNPM) -C $(WEB) run lint

test: ## pytest (unit only: no DB, Redis or server needed)
	$(POETRY) run pytest -v

audit: ## pip-audit --strict (security-gated deps)
	$(POETRY) run pip-audit --strict

config-docs: ## Regenerate .env.example + README config table from app/config.py
	$(PY) scripts/gen_config_docs.py

config-check: ## Fail if .env.example / README config table are out of date
	$(PY) scripts/gen_config_docs.py --check

check: lint config-check test build-web ## Everything CI checks: lint, config docs, tests, SPA build

# ── Run locally ──────────────────────────────────────────────────

dev: ## API dev server (python run.py, port 80 by default)
	$(PY) run.py

worker: ## Celery worker (picks --pool solo on Windows)
	$(PY) dev_worker.py

web: ## SPA dev server on :5173 (set VITE_DEV_PROXY_TARGET for `make dev`)
	$(PNPM) -C $(WEB) run dev

build-web: ## Production SPA build into frontend/dist
	$(PNPM) -C $(WEB) run build

preflight: ## Check the database (and Redis if housekeeping is on)
	$(PY) scripts/preflight.py api

# ── Database ─────────────────────────────────────────────────────

migrate: ## alembic upgrade head
	$(POETRY) run alembic upgrade head

migration: ## New autogenerated migration: make migration MSG="..." (then edit it by hand)
	$(POETRY) run alembic revision --autogenerate -m "$(MSG)"

housekeeping: ## One-off ingest without Celery: make housekeeping ARGS="--dry-run dir"
	$(PY) housekeeping.py $(ARGS)

# ── Docker (Postgres and Redis are external; see docs/DEPLOYMENT.md) ─

up: ## docker compose up -d --build
	docker compose up -d --build

down: ## docker compose down
	docker compose down

logs: ## Follow api, worker and web logs
	docker compose logs -f api worker web

build: ## Build the shared Poetry base image, then the app images
	docker compose build base
	docker compose build

clean: ## Remove caches and the SPA build output
	$(PY) -c "import pathlib, shutil; [shutil.rmtree(p, ignore_errors=True) for p in [*pathlib.Path('.').rglob('__pycache__'), pathlib.Path('.pytest_cache'), pathlib.Path('.ruff_cache'), pathlib.Path('$(WEB)/dist')] if '.venv' not in p.parts and 'node_modules' not in p.parts]"
