# Frontend dev-server settings. All optional; copy to frontend/.env.local to
# override. Not used in production — the built bundle is static and nginx
# proxies to the api service directly.
#
# Where `pnpm dev` proxies /api, /ui and /health.
# Default 127.0.0.1:5000 matches the compose `api` service, which publishes
# host 5000 -> container 80. Point this at http://127.0.0.1:80 if you are
# running `python run.py` directly instead of via compose.
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:5000

# Port for the Vite dev server.
# VITE_DEV_PORT=5173
