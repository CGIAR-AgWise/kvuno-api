ARG POETRY_VERSION=2.3.2
FROM ghcr.io/masgeek/python-3.14-poetry:${POETRY_VERSION} AS builder

WORKDIR /app

# poetry.lock pins the dependency set; without it the build re-resolves on every
# image and drifts from CI. README.md is required because pyproject.toml declares
# `readme = "README.md"`, and Poetry validates that at install time.
COPY pyproject.toml poetry.lock README.md ./

RUN poetry install --no-root --without dev --no-ansi

FROM python:3.14-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH" \
    HOME=/app

# Same fixed uid/gid as the API image: both write the shared data volume.
ARG UID=1000
ARG GID=1000
RUN groupadd -g ${GID} app && useradd -u ${UID} -g app -d /app -s /sbin/nologin --no-log-init app

WORKDIR /app

COPY --from=builder /app/.venv /app/.venv
# `COPY . .` already brings in docker/entrypoint.worker.sh (.dockerignore only
# excludes Dockerfile*), so it only needs to be made executable.
COPY --chown=app:app . .
# See Dockerfile.prod.dockerfile: a new volume inherits this ownership.
RUN chown app:app /app && chmod +x /app/docker/entrypoint.worker.sh \
    && install -d -o app -g app /app/static/data /app/static/data/uploads

USER app

# Verifies database + Redis reachability before Celery starts, then execs CMD.
# A worker without a broker would otherwise idle forever instead of failing.
ENTRYPOINT ["/app/docker/entrypoint.worker.sh"]

# Shell form to read LOG_LEVEL (the one level for every process) and
# CELERY_CONCURRENCY. `exec` keeps celery as PID 1's direct child so signals
# (SIGTERM on stop) still reach it. One process by default: two in a 2 GB
# worker got processes OOM-killed mid-import; raise both together.
CMD ["sh", "-c", "exec celery -A app.celery_app worker --loglevel=\"${LOG_LEVEL:-INFO}\" --concurrency=\"${CELERY_CONCURRENCY:-1}\""]
