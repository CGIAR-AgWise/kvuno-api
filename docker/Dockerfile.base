# Copyright (c) 2026 Munywele Consulting LTD. All rights reserved.
#
# Shared builder base: python:3.14-slim + a pinned Poetry (installed via uv).
#
# Image: ghcr.io/masgeek/python-3.14-poetry:<POETRY_VERSION>
# The version is the TAG, not part of the name.
#
# CI does NOT build or push this image. Build locally:
#     docker compose build base
#     docker push ghcr.io/masgeek/python-3.14-poetry:2.3.2   # optional
#
# Consumers:
#     ARG POETRY_VERSION=2.3.2
#     FROM ghcr.io/masgeek/python-3.14-poetry:${POETRY_VERSION} AS builder
#
# ⚠️ POETRY_VERSION MUST match the Poetry that generated poetry.lock. Mismatched
# 2.x releases compute different content-hashes and `poetry install` aborts with
# "pyproject.toml changed significantly since poetry.lock was last generated".
#
# When bumping Poetry, update ALL of these in the same commit:
#   1. docker/Dockerfile.base           — ARG POETRY_VERSION
#   2. docker/Dockerfile                — ARG POETRY_VERSION
#   3. docker/Dockerfile.prod.dockerfile— ARG POETRY_VERSION
#   4. docker/Dockerfile.worker         — ARG POETRY_VERSION
#   5. docker-compose.yml               — base service `image:` tag AND build arg
# Then regenerate poetry.lock with the same Poetry and rebuild the base image.
# UV_VERSION is independent of the lock; bump it freely.

# syntax=docker/dockerfile:1
ARG UV_VERSION=0.9.0

FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

FROM python:3.14-slim

ARG POETRY_VERSION=2.3.2

LABEL org.opencontainers.image.title="python-3.14-poetry" \
      org.opencontainers.image.description="python:3.14-slim with pinned Poetry" \
      org.opencontainers.image.source="https://github.com/masgeek" \
      org.opencontainers.image.vendor="Munywele Consulting LTD" \
      org.opencontainers.image.version="${POETRY_VERSION}"

COPY --from=uv /uv /uvx /usr/local/bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_TOOL_DIR=/opt/uv-tools \
    UV_TOOL_BIN_DIR=/usr/local/bin \
    UV_LINK_MODE=copy \
    UV_PYTHON_PREFERENCE=only-system \
    UV_PYTHON_DOWNLOADS=never \
    POETRY_NO_INTERACTION=1 \
    POETRY_NO_ANSI=1 \
    POETRY_VIRTUALENVS_IN_PROJECT=true \
    POETRY_VERSION=${POETRY_VERSION}

# Isolated Poetry venv under /opt/uv-tools, shim in /usr/local/bin.
# Verify the exact version in the same layer.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv tool install "poetry==${POETRY_VERSION}" \
    && installed="$(poetry --version)" \
    && case "${installed}" in \
         *"version ${POETRY_VERSION})"*) ;; \
         *) echo "expected poetry ${POETRY_VERSION}, got: ${installed}" >&2; exit 1 ;; \
       esac